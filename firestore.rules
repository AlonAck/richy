rules_version = '2';

// Richy security rules.
// Each user can read and write ONLY their own document at users/{uid}.
// You (the project owner) can still see every user's data in the Firebase
// console regardless of these rules - the console bypasses them.
//
// HOW TO APPLY:
//   Firebase console -> Build -> Firestore Database -> Rules tab ->
//   paste this whole file -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Bank Sync inbox: written ONLY by the api/bank-sync.js server function
      // (the Admin SDK bypasses these rules). The owner may read and drain it;
      // no client may create or edit inbox docs.
      match /syncInbox/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if false;
      }

      // Transactions, one document per entry, since the document split of
      // 4 Sep 2026 (FIRESTORE_SPLIT.md). Owner-only, like the parent. With
      // each transaction its own document, two clients - the web app and the
      // iOS app - can add, edit and delete at the same time: each touches only
      // its own documents, never one shared array.
      match /tx/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Bank Sync key -> uid mapping. Created by the owner when enabling Bank
    // Sync, deleted when disabling (revocation). The doc id is the SHA-256 of
    // the 128-bit random key (the raw key never touches the database), so
    // get-by-id is not guessable; list is denied so ids can't be enumerated.
    match /syncKeys/{key} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }

    // Households (Collab / couples mode). A shared document that two or more
    // members read and write together. Private data is NEVER stored here - it
    // stays in each member's users/{uid} doc - so document-level read access is
    // safe to grant to every member.
    match /households/{hid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberUids;
      }
      // An invited (but not yet joined) user is identified by their verified email
      // sitting in pendingEmails - this lets them see and accept the invite.
      function isInvited() {
        return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email in resource.data.pendingEmails;
      }
      // Create: only if the creator lists themselves as a member and as creator.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdBy == request.auth.uid;
      // Read: members, or an invited email (so the invite is discoverable).
      allow read: if isMember() || isInvited();
      // Update. Existing members may change anything on the doc. An invited
      // (not-yet-joined) user gets exactly two moves and nothing else: accept
      // their own invite, or decline it. `allow update: if isMember() ||
      // isInvited()` used to be the whole rule, which let someone who had only
      // been invited rewrite memberUids to evict the creator, reassign
      // createdBy, or blank budgets/goals/categories before ever joining
      // (security review 15 Aug, §9; still open through the 30 Aug audit).
      //
      // Accepting is the ONLY write that may touch membership, and it is pinned
      // field by field: memberUids gains exactly the caller's own uid and loses
      // nobody; members grows by exactly one entry, that entry is the caller's,
      // and every existing entry survives (hasAll); pendingEmails loses only
      // the caller's own address. Anything else - budgets, goals, categories,
      // tx, name, createdBy - is outside affectedKeys and therefore denied.
      //
      // `members` has to be in the allowed set because CLOUD.acceptInvite writes
      // it alongside memberUids in one update. Leaving it out does not harden
      // anything; it just makes every invite acceptance fail permission-denied.
      function acceptsOwnInvite() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids", "members", "pendingEmails"])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.pendingEmails == resource.data.pendingEmails.removeAll([request.auth.token.email])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members[resource.data.members.size()].uid == request.auth.uid;
      }
      // Declining is strictly de-escalating: drop your own address from the
      // invite list and touch nothing else. No membership field may move.
      function declinesOwnInvite() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingEmails"])
          && request.resource.data.pendingEmails == resource.data.pendingEmails.removeAll([request.auth.token.email]);
      }
      allow update: if isMember()
        || (isInvited() && (acceptsOwnInvite() || declinesOwnInvite()));
      // Delete: only members (e.g. winding down the household).
      allow delete: if isMember();
    }

    // ── The social graph (friends / following) ───────────────────────────────
    // Independent of households: following someone shares nothing financial and
    // joining a household is not following. The two never read each other.
    //
    // The split between profiles/ and profileStats/ is the whole privacy design
    // and must not be collapsed into one document:
    //   profiles/{uid}      identity only - handle, display name. Any signed-in
    //                       user may read it, because you cannot send a follow
    //                       request to someone you cannot find.
    //   profileStats/{uid}  level, rank, streaks, shared badge ids. Readable
    //                       ONLY by an approved follower.
    // Amounts are never written to either. Under Amendment 13 financial data is
    // very likely sensitive personal information, so nothing that discloses or
    // implies net worth or income belongs in a document another person can read.
    function followId(a, b) { return a + "__" + b; }
    function follows(follower, target) {
      return exists(/databases/$(database)/documents/follows/$(followId(follower, target)));
    }

    // Handle -> uid index. `get` only: list is denied so the directory cannot be
    // scraped for every handle in the app. Claiming is create-only, so a handle
    // can never be stolen from its owner by overwrite.
    match /handles/{handle} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /profiles/{uid} {
      // Identity card. Readable by any signed-in user so handle lookup and
      // invite links work; list denied so the user base cannot be enumerated.
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /profileStats/{uid} {
      // Your own, or someone who has approved you. Everything else is invisible.
      allow get: if request.auth != null
        && (request.auth.uid == uid || follows(request.auth.uid, uid));
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A pending request, id "<from>__<to>". Either party can see it; only the
    // sender can create it, and it must name them honestly as the sender.
    // Deleting is how both accept and decline resolve - the target creates the
    // follow edge first, then removes the request.
    match /followRequests/{reqId} {
      allow get, list: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && reqId == followId(request.auth.uid, request.resource.data.to);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow update: if false;
    }

    // The edge itself, id "<follower>__<target>". Created ONLY by the target -
    // this is what "you approve each one" means in the data: a follower cannot
    // grant themselves access. Either party may delete it (unfollow, or remove
    // a follower), so consent stays revocable from both ends.
    match /follows/{edgeId} {
      allow get, list: if request.auth != null
        && (resource.data.follower == request.auth.uid || resource.data.target == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.target == request.auth.uid
        && request.resource.data.follower != request.auth.uid
        && edgeId == followId(request.resource.data.follower, request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.follower == request.auth.uid || resource.data.target == request.auth.uid);
      allow update: if false;
    }

    // Bank Leumi FinTeka (direct Open Banking connect, api/leumi-fintaka.js):
    // leumiFinteka/{uid} holds access/refresh tokens, and leumiOAuthState/{state}
    // holds a one-time PKCE verifier during the OAuth handshake. Neither is
    // listed here on purpose - the catch-all deny below already blocks every
    // client read/write. Only the Admin SDK (server function, bypasses rules)
    // ever touches these. The client only ever sees the SAFE status fields via
    // the ?action=status endpoint, mirrored into its own users/{uid}.leumiFinteka.

    // WhatsApp Richard Watch alerts (api/whatsapp.js): whatsappOptIn/{uid} holds
    // the linked phone number and the opt-in/session state that gates every
    // outbound message; whatsappPhones/{phone} maps an inbound sender back to a
    // uid. Same pattern as leumiFinteka above - deliberately absent here so the
    // catch-all deny covers them; only the Admin SDK touches them, and the
    // client only ever sees safe status via ?action=status.

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
