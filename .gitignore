.env
.env.local
.vercel
node_modules

# Production build output (generated by build.mjs on Vercel)
public

# Firebase admin service-account keys — never commit
service-account.json
**/service-account.json
*-firebase-adminsdk-*.json

# Native iOS app (RichyIOS/) - per-machine files only; Richy.xcodeproj itself is committed
RichyIOS/Richy.xcodeproj/xcuserdata/
RichyIOS/Richy.xcodeproj/project.xcworkspace/xcuserdata/
RichyIOS/Info.plist
RichyIOS/Resources/GoogleService-Info.plist
RichyIOS/xcuserdata/
RichyIOS/.build/

# Skill reference media (2026-09-08) — 87MB of screen recordings across the
# .claude/ and .agents/ mirrors. Kept on disk for design reference, out of
# history so clones (incl. the macOS CI runner on every RichyIOS/ push) stay small.
.claude/skills/*/reference/*.mp4
.claude/skills/*/reference/*.mov
.agents/skills/*/reference/*.mp4
.agents/skills/*/reference/*.mov

# Rendered ad video — regenerate from marketing/ads/blender/
marketing/ads/renders/
